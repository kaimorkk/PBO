report 52193433 "Perf Target Setting Report"
{
    Caption = 'Target Setting Report';
    UsageCategory = ReportsAndAnalysis;
    ApplicationArea = All;
    ProcessingOnly = true;

    dataset
    {
        dataitem(GoalHeader; "Perf Goal Header")
        {
            RequestFilterFields = "Period Code", "Supervisor No.", Status, "Workplan No.";

            dataitem(GoalLine; "Perf Goal Line")
            {
                DataItemLink = "Goal No." = field("No.");

                trigger OnAfterGetRecord()
                var
                    EmployeeMgt: Codeunit "Perf Employee Mgt";
                begin
                    Buffer.Init();
                    EntryNo += 1;
                    Buffer."Entry No." := EntryNo;
                    EmployeeMgt.FillReportBuffer(Buffer, GoalHeader."Employee No.");
                    Buffer."Period Code" := GoalHeader."Period Code";
                    Buffer."Text Value 1" := CopyStr(Format(GoalHeader.Status) + ' - ' + GoalLine."Key Result Area", 1, MaxStrLen(Buffer."Text Value 1"));
                    Buffer."Text Value 2" := GoalLine."Target Description";
                    Buffer."Decimal Value 1" := GoalLine."Weightage %";
                    Buffer."Decimal Value 2" := GoalLine."Target Value";
                    Buffer."Boolean Value 1" := GoalHeader."Staff Signed" and GoalHeader."Supervisor Signed";
                    Buffer."Date Value 1" := GoalHeader."CEO Approval Date";
                    Buffer.Insert();
                end;
            }
        }
    }

    trigger OnPostReport()
    var
        BufferPage: Page "Perf Report Buffer List";
    begin
        // Comprehensive Target Setting Report generated by Manager HR (FRD 2.viii):
        // one row per Key Result Area with weight, target, signatures and CEO approval date.
        BufferPage.LoadBuffer(Buffer);
        BufferPage.RunModal();
    end;

    var
        Buffer: Record "Perf Report Buffer" temporary;
        EntryNo: Integer;
}
